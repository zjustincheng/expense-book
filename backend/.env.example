HOST=127.0.0.1
PORT=4000
# DB_DRIVER can be "sqlite" (default for file/memory paths) or "postgres" (auto-detected for postgres:// URLs).
# DB_DRIVER=sqlite
DATABASE_URL=./data/expense-book.sqlite
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://expense_book:password@127.0.0.1:5432/expense_book
ATTACHMENT_DIR=./data/attachments
# Set AUTH_MODE=local for built-in SQLite email/password accounts, or AUTH_MODE=development for single-user loopback dev.
AUTH_MODE=development
DEV_USER_EMAIL=developer@example.test
APP_URL=http://localhost:3000
# Optional SES delivery. Without a sender, admins share invitation links.
# AWS_REGION=us-east-1
# INVITATION_FROM_EMAIL=invites@example.com
