# Local Docker Compose testing configuration
APP_URL=http://localhost:3000
FRONTEND_PORT=3000
AUTH_MODE=local
DATA_DIR=./data
ATTACHMENT_DIR=/data/attachments

# Default SQLite backend
DB_DRIVER=sqlite
DATABASE_URL=/data/expense-book.sqlite

# Optional local PostgreSQL backend (run: docker compose --profile postgres up -d)
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://expense_book:expense_book@postgres:5432/expense_book
# POSTGRES_USER=expense_book
# POSTGRES_PASSWORD=expense_book
# POSTGRES_DB=expense_book
