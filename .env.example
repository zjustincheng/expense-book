# Self-hosted Docker Compose configuration for expbook.culater.cc
APP_URL=https://expbook.culater.cc
AUTH_MODE=local
DATA_DIR=./data
DATABASE_URL=/data/expense-book.sqlite
ATTACHMENT_DIR=/data/attachments

# Cloudflare Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels
# Route public hostname expbook.culater.cc -> http://frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=
