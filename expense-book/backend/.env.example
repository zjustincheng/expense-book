HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://expense_book:expense_book@localhost:5432/expense_book
# Explicit local-only identity. Never accepted with NODE_ENV=production.
AUTH_MODE=development
DEV_USER_EMAIL=developer@example.test
APP_URL=http://localhost:3000
# Required when AUTH_MODE=jwt; must match your identity provider.
# JWT_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# JWT_AUDIENCE=APP_CLIENT_ID
# JWT_JWKS_URL=https://cognito-idp.REGION.amazonaws.com/POOL_ID/.well-known/jwks.json
# COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com
# Optional SES delivery. Without a sender, admins share invitation links.
# AWS_REGION=us-east-1
# S3_BUCKET=expense-book-attachments
# INVITATION_FROM_EMAIL=invites@example.com
